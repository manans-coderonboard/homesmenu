APP_NAME="HomesMenu"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

# Where the Next.js app lives (used by Google OAuth redirect + CORS)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=homesmenu
DB_USERNAME=homesmenu
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Local disk for dev; set to "s3" in production (fill AWS_* below). The app is
# disk-agnostic — uploads store {path,disk} and resolve URLs via Storage::url().
FILESYSTEM_DISK=public

# ---- Google OAuth (create credentials at https://console.cloud.google.com) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

# ---- S3 + CloudFront (production file storage) ----
# Set FILESYSTEM_DISK=s3 to store uploads in S3 instead of local disk.
# On AWS EC2 the IAM instance role supplies credentials automatically — leave
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY BLANK there. Fill them only when
# running outside AWS (e.g. local testing against a real bucket).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
# AWS_URL = the CloudFront ASSETS distribution domain (e.g. https://abc123.cloudfront.net).
# Storage::url() prefixes object paths with this to build public image URLs.
# Leave blank to fall back to the raw S3 endpoint URL.
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
